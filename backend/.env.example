# ==============================================================================
# SHOPKART - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` inside your backend directory (or root) and fill in your values.
#
#   $ cp .env.example backend/.env
#
# ⚠️ SECURITY NOTICE: Never commit real credentials, API secrets, or `.env` files to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port on which the Express backend server will listen.
# Note: Defaults to 8080. If frontend/vite.config.js proxies to 8081, set PORT=8081.
PORT=8080

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# Connection URI for MongoDB.
#
# MongoDB Atlas Cloud Cluster:
# MONGO_URI=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens stored in HTTP-only cookies.
# Use a high-entropy random string (e.g., generated with `openssl rand -hex 32`).
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Test API keys from Razorpay Dashboard (Settings -> API Keys).
# Used to generate payment orders and verify cryptographic HMAC-SHA256 signatures.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
